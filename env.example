# Copy to /app/data/env only when overriding package defaults.
# Values use shell syntax because start.sh sources this administrator-owned file.

# Form notifications default to CLOUDRON_MAIL_FROM.
INSTATIC_FORM_EMAIL_TO='website-owner@example.com'
INSTATIC_FORM_EMAIL_SUBJECT_PREFIX='[Website]'

# For an additional public origin, include the primary Cloudron origin too.
# PUBLIC_ORIGIN='https://primary.example.com,https://alias.example.com'
