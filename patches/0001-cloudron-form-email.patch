+import { afterEach, describe, expect, it } from 'bun:test'
+import { chmod, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { sendFormNotification } from '../../../server/forms/mail'
+
+const originalEnv = { ...process.env }
+const temporaryDirectories: string[] = []
+
+afterEach(async () => {
+  process.env = { ...originalEnv }
+  await Promise.all(temporaryDirectories.splice(0).map((path) => rm(path, { recursive: true })))
+})
+
+describe('Cloudron form mail transport', () => {
+  it('skips delivery when no Cloudron sender is configured', async () => {
+    delete process.env.CLOUDRON_MAIL_FROM
+    delete process.env.INSTATIC_FORM_EMAIL_TO
+    expect(await sendFormNotification({ formId: 'contact', pageId: 'home', rowId: '1', values: {} }))
+      .toBe(false)
+  })
+
+  it('passes a sanitized message to the configured sendmail command', async () => {
+    const directory = await mkdtemp(join(tmpdir(), 'instatic-mail-'))
+    temporaryDirectories.push(directory)
+    const command = join(directory, 'sendmail')
+    const capture = join(directory, 'message.eml')
+    const argsCapture = join(directory, 'args.txt')
+    await writeFile(command, '#!/bin/sh\nprintf \'%s\\n\' "$@" > "$ARGS_CAPTURE"\ncat > "$MAIL_CAPTURE"\n')
+    await chmod(command, 0o755)
+
+    process.env.INSTATIC_SENDMAIL_PATH = command
+    process.env.MAIL_CAPTURE = capture
+    process.env.ARGS_CAPTURE = argsCapture
+    process.env.CLOUDRON_MAIL_FROM = 'website@example.com'
+    process.env.CLOUDRON_MAIL_FROM_DISPLAY_NAME = 'Website\r\nBcc: injected@example.com'
+    process.env.INSTATIC_FORM_EMAIL_TO = 'owner@example.com'
+    process.env.INSTATIC_MSMTP_CONFIG = '/run/instatic/msmtprc'
+
+    const sent = await sendFormNotification({
+      formId: 'contact',
+      pageId: 'home',
+      rowId: 'row-1',
+      values: { email: 'visitor@example.com', message: 'Hello' },
+    })
+    const message = await readFile(capture, 'utf8')
+    const args = await readFile(argsCapture, 'utf8')
+
+    expect(sent).toBe(true)
+    expect(message).toContain('From: Website Bcc: injected@example.com <website@example.com>')
+    expect(message).toContain('To: owner@example.com')
+    expect(message).toContain('email: visitor@example.com')
+    expect(message).toContain('message: Hello')
+    expect(message).not.toContain('\r\nBcc: injected@example.com\r\n')
+    expect(args).toBe('-C\n/run/instatic/msmtprc\n-t\n-oi\n')
+  })
+})
