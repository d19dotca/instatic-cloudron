+interface FormNotification {
+  formId: string
+  pageId: string
+  rowId: string
+  values: Record<string, unknown>
+}
+
+const SEND_TIMEOUT_MS = 10_000
+
+function headerValue(value: string): string {
+  return value.replace(/[\r\n]+/g, ' ').trim()
+}
+
+function configuredRecipient(): string | null {
+  const value = process.env.INSTATIC_FORM_EMAIL_TO?.trim()
+    || process.env.CLOUDRON_MAIL_FROM?.trim()
+  return value ? headerValue(value) : null
+}
+
+function senderAddress(): string | null {
+  const value = process.env.CLOUDRON_MAIL_FROM?.trim()
+  return value ? headerValue(value) : null
+}
+
+function senderHeader(address: string): string {
+  const displayName = headerValue(
+    process.env.CLOUDRON_MAIL_FROM_DISPLAY_NAME?.trim() || 'Instatic',
+  ).replace(/["\\]/g, '')
+  return `${displayName} <${address}>`
+}
+
+function notificationBody(input: FormNotification): string {
+  const values = Object.entries(input.values)
+    .map(([key, value]) => `${key}: ${typeof value === 'string' ? value : JSON.stringify(value)}`)
+    .join('\n')
+
+  return [
+    'A public Instatic form was submitted.',
+    '',
+    `Form: ${input.formId}`,
+    `Page: ${input.pageId}`,
+    `Submission row: ${input.rowId}`,
+    '',
+    values || '(No submitted values)',
+    '',
+  ].join('\n')
+}
+
+export async function sendFormNotification(input: FormNotification): Promise<boolean> {
+  const to = configuredRecipient()
+  const from = senderAddress()
+  if (!to || !from) return false
+
+  const subjectPrefix = headerValue(
+    process.env.INSTATIC_FORM_EMAIL_SUBJECT_PREFIX?.trim() || '[Instatic]',
+  )
+  const message = [
+    `From: ${senderHeader(from)}`,
+    `To: ${to}`,
+    `Subject: ${subjectPrefix} New form submission`,
+    `Date: ${new Date().toUTCString()}`,
+    `Message-ID: <${crypto.randomUUID()}@instatic.local>`,
+    'MIME-Version: 1.0',
+    'Content-Type: text/plain; charset=UTF-8',
+    'Content-Transfer-Encoding: 8bit',
+    '',
+    notificationBody(input),
+  ].join('\r\n')
+
+  const sendmailPath = process.env.INSTATIC_SENDMAIL_PATH ?? '/usr/sbin/sendmail'
+  const configPath = process.env.INSTATIC_MSMTP_CONFIG?.trim()
+  const command = configPath
+    ? [sendmailPath, '-C', configPath, '-t', '-oi']
+    : [sendmailPath, '-t', '-oi']
+  const processHandle = Bun.spawn(command, {
+    env: process.env,
+    stdin: 'pipe',
+    stdout: 'ignore',
+    stderr: 'pipe',
+  })
+  processHandle.stdin.write(message)
+  processHandle.stdin.end()
+  const timeout = setTimeout(() => processHandle.kill(), SEND_TIMEOUT_MS)
+  const exitCode = await processHandle.exited
+  clearTimeout(timeout)
+
+  if (exitCode !== 0) {
+    const stderr = await new Response(processHandle.stderr).text()
+    throw new Error(`sendmail exited with ${exitCode}: ${stderr.trim().slice(0, 500)}`)
+  }
+  return true
+}
